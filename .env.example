# Append to api/.env; features remain off until locally validated.
HLTV_REGISTRY_ENABLED=false
HLTV_STORAGE_ROOT=/srv/noname-hltv
HLTV_REGISTRY_DB=/srv/noname-hltv/registry.db
HLTV_MAX_DEMO_BYTES=268435456
HLTV_MIN_DISK_FREE_BYTES=10737418240
HLTV_CLEANUP_ENABLED=false
HLTV_CLEANUP_DRY_RUN=true
# Explicit manual-review policy: unflagged normal demos can expire without an analyzer.
# Actual failures, attempted analysis, holds and evidence remain protected.
HLTV_MANUAL_RETENTION_ENABLED=false
# Optional untouched Ghosty upstream decoder/log matching/concussion estimates.
HLTV_UPSTREAM_ENABLED=false
HLTV_STATISTICS_ENABLED=false
HLTV_STATISTICS_AUTO_COLLECT=false
HLTV_AIM_GAP_REVIEW_ENABLED=false
HLTV_HIT_EVIDENCE_ALERTS_ENABLED=false
HLTV_HIT_ALERT_MIN_CONC_WINDOWS=20
HLTV_HIT_HIGH_CONC_PERCENT=100
HLTV_HIT_REPEAT_GAMES=2
HLTV_HIT_REPEAT_WINDOW=3
HLTV_HIT_BASELINE_GAMES=25
HLTV_HIT_BASELINE_RISE_POINTS=20
HLTV_ASSETS_ROOT=/srv/noname-hltv-assets
HLTV_UPSTREAM_ROOT=/opt/noname-hltv-tools
HLTV_UPSTREAM_PYTHON=python3
HLTV_UPSTREAM_MEMORY_BYTES=2147483648
HLTV_PARSER_LOG_ROOT=/var/lib/noname-parser
# Same explicit user IDs as the bot. Empty configuration denies all access.
HLTV_REVIEW_ALLOWED_USER_IDS=
# JSON map of allowed Discord user ID -> SHA-256 of individual random token.
# Keep single quotes around JSON when configuring dotenv.
HLTV_REVIEW_TOKEN_HASHES='{}'
# Username/password login. Existing credentials remain available for owner setup/recovery.
HLTV_REVIEW_ACCOUNTS_ENABLED=false
# Only these Discord identities can create/reset/disable reviewer accounts.
HLTV_REVIEW_OWNER_USER_IDS=
HLTV_FRIENDLY_DEMO_NAMES_ENABLED=false
