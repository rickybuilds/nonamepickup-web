[Unit]
Description=Final Fortress League roster and draft
After=network.target

[Service]
Type=simple
User=ffl
Group=ffl
WorkingDirectory=/opt/ffl
EnvironmentFile=/etc/ffl.env
ExecStart=/opt/ffl/runtime/bin/node /opt/ffl/server.mjs
Restart=on-failure
RestartSec=3
StateDirectory=ffl
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ffl

[Install]
WantedBy=multi-user.target
