# Authentication remains in the same root-only curl config used by the
# completed replay uploader. Do not put the bearer token in this file.
PICKUP_REPLAY_ROOT=/root/steamcmd/tfc/tfc/addons/amxmodx/data/pickup_replays
PICKUP_LIVE_INGEST_URL=https://example.invalid/api/pickup-live/ingest
PICKUP_SERVER_ID=east
PICKUP_CURL_CONFIG=/root/.config/tfc/pickup-upload.curl

# The defaults send complete appended CSV lines twice per second and emit a
# heartbeat when a round is temporarily quiet.
PICKUP_LIVE_INTERVAL_MS=500
PICKUP_LIVE_HEARTBEAT_MS=5000
PICKUP_LIVE_PER_FILE_BYTES=65536
