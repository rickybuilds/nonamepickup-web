# This file contains no upload token. Authentication belongs in the root-only
# curl config referenced by PICKUP_CURL_CONFIG.
PICKUP_REPLAY_ROOT=/root/steamcmd/tfc/tfc/addons/amxmodx/data/pickup_replays
PICKUP_UPLOAD_URL=https://example.invalid/api/pickup-replays
PICKUP_SERVER_ID=east
PICKUP_SPOOL_ROOT=/var/lib/tfc-pickup-uploader
PICKUP_CURL_CONFIG=/root/.config/tfc/pickup-upload.curl

# Zero retains local raw rounds and archives indefinitely. Set a positive
# number only after choosing the game-server retention window.
PICKUP_DELETE_AFTER_DAYS=0
